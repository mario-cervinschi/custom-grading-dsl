        "module": "commonjs",
        "target": "es2020",
        "outDir": "./out",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "out"
    ]
}