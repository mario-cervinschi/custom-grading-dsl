{
  "name": "code-helper",
  "displayName": "Code Helper",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "codesuggestion",
        "aliases": ["Code Suggestion", "codesuggestion"],
        "extensions": [".ops"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "codesuggestion",
        "scopeName": "source.codesuggestion",
        "path": "./syntaxes/codesuggestion.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "code-helper.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-code-suggestion": "file:../../parser"
  }
}