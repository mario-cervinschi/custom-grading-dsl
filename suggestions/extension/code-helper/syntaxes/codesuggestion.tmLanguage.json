{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Code Suggestion",
  "scopeName": "source.codesuggestion",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.codesuggestion",
          "match": "(?i)\\b(APPLY|TO|WHEN|EXISTS|EXPLAIN|IN)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.codesuggestion",
          "match": "(?i)\\b(MAX|MIN|ROUND)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.codesuggestion",
          "match": "\\b(nothing|fraud|cancelled|invalid|alert|conflict|ungraded|obscured|absent|present|excused|toolow)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.codesuggestion",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.codesuggestion",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.codesuggestion",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.codesuggestion",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.codesuggestion",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.codesuggestion",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.codesuggestion",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.ternary.codesuggestion",
          "match": "[?:]"
        },
        {
          "name": "keyword.operator.assignment.codesuggestion",
          "match": "(?<![:=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.regex.codesuggestion",
          "match": "!?~"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.codesuggestion",
          "match": ";"
        },
        {
          "name": "punctuation.separator.codesuggestion",
          "match": ","
        },
        {
          "name": "punctuation.bracket.codesuggestion",
          "match": "[\\[\\]()]"
        }
      ]
    }
  }
}
