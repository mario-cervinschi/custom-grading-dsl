{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "codesuggestion",
      "camelcase": "Codesuggestion",
      "title": "Codesuggestion",
      "scope": "source.codesuggestion",
      "file-types": [
        "codesuggestion"
      ],
      "injection-regex": "^codesuggestion$",
      "class-name": "TreeSitterCodesuggestion"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Codesuggestion grammar for tree-sitter",
    "authors": [
      {
        "name": "Mario"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-codesuggestion"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}